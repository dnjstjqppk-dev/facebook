# Core Environment Configuration
NODE_ENV=development
APP_ENV=local

# Security & Tokens
JWT_SECRET=nova-enterprise-secure-jwt-secret-key-32chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=336h

# Microservice Ports
API_GATEWAY_PORT=8080
IDENTITY_SERVICE_PORT=8081
SOCIAL_GRAPH_SERVICE_PORT=8082
PROFILES_SERVICE_PORT=8083

# Service URLs
IDENTITY_SERVICE_URL=http://localhost:8081
SOCIAL_GRAPH_SERVICE_URL=http://localhost:8082
PROFILES_SERVICE_URL=http://localhost:8083

# Database & Cache
DATABASE_URL=postgres://nova_admin:nova_secure_password@localhost:5432/nova_social?sslmode=disable
REDIS_URL=redis://localhost:6379/0
KAFKA_BROKERS=localhost:9092
OPENSEARCH_URL=http://localhost:9200
